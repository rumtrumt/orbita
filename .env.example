# Все значения необязательны, ниже указаны значения по умолчанию.

# ORBITA_HOST=127.0.0.1
# ORBITA_PORT=8000
# ORBITA_DEFAULT_TIMEZONE=Europe/Moscow
# ORBITA_DATA_DIR=            # по умолчанию каталог данных пользователя
# ORBITA_DATABASE_URL=        # по умолчанию SQLite в ORBITA_DATA_DIR

# rules — без LLM, llm — только модель, hybrid — правила и модель при сомнении
# ORBITA_NLU_MODE=hybrid

# Подойдёт любой OpenAI-совместимый API, например Groq или OpenRouter:
# ORBITA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ORBITA_LLM_MODEL=qwen3:4b
# ORBITA_LLM_API_KEY=ollama

# ORBITA_WHISPER_MODEL=large-v3-turbo   # на слабых машинах: small
# ORBITA_WHISPER_DEVICE=auto            # auto, cuda, cpu

# ORBITA_TTS_PROVIDER=piper             # piper, edge, off
# ORBITA_PIPER_VOICE=ru_RU-irina-medium
# ORBITA_EDGE_VOICE=ru-RU-SvetlanaNeural

# ORBITA_SEMANTIC_SEARCH=true
